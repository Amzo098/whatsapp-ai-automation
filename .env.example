# ================================
# CONFIGURATION WHATSAPP AI BOT
# ================================

# Clé API Google Gemini (aistudio.google.com)
GEMINI_API_KEY=ta_cle_gemini_ici

# Token WhatsApp Cloud API (Meta Developer)
WHATSAPP_TOKEN=ton_token_whatsapp_ici

# ID du numéro WhatsApp (Meta Developer)
